{
  "name": "step-viewer-3d",
  "version": "0.35.0",
  "private": true,
  "description": "Build and test tooling for the STEP Viewer 3D plugin for Orca. The plugin itself needs no build step to run; npm is only used to fetch the third-party files in editor/vendor.",
  "license": "MIT AND LGPL-2.1-only",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node dev/build.mjs && node dev/patch-occt.mjs",
    "verify-build": "node dev/build.mjs --check && node dev/patch-occt.mjs --check",
    "test": "node --test test/",
    "privacy": "sh dev/privacy-check.sh"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "occt-import-js": "0.0.23",
    "three": "0.187.0"
  }
}
